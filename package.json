{
  "name": "mobi-book-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Git-first bilingual book publishing and browser-based Markdown/MDX studio for GitHub Pages.",
  "scripts": {
    "content": "node scripts/generate-content.mjs",
    "predev": "npm run content",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run content",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs && node scripts/verify-dist.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check": "npm run content && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "pretty": "prettier --write -c ."
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@mdx-js/react": "^3.1.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@uiw/react-codemirror": "^4.25.4",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "katex": "^0.16.22",
    "lucide-react": "^0.468.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.1",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "prismjs": "^1.30.0",
    "@mdxeditor/editor": "^4.3.2",
    "mermaid": "^12.1.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.1.2",
    "gray-matter": "^4.0.3",
    "marked": "^16.3.0",
    "remark-frontmatter": "^5.0.0",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vite": "^8.1.0",
    "@types/prismjs": "^1.26.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
